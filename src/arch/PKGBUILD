pkgname=haxefetch
pkgver=1.0.0_b
pkgrel=1
pkgdesc="Fetch program written in Haxe"
arch=('x86_64')
url="https://github.com/ACoolioDude/Haxefetch"
license=('MIT')

source=("haxefetch::https://github.com/ACoolioDude/Haxefetch/raw/refs/heads/main/binary/haxefetch")
sha256sums=('dd786c22ea0b59130569693f4efc05ea2f9f91fcf59b9fd0dc40bd522564ebfe')

package() {
	install -Dm755 haxefetch "$pkgdir/usr/bin/haxefetch"
}

optdepends=(
	'inxi: for RAM type'
	'vulkan-tools: for Vulkan version (vulkaninfo)'
	'vulkan-headers: for Vulkan instance'
	'vulkan-intel: for Vulkan GPU driver (Intel)'
	'vulkan-radeon: for Vulkan GPU driver (AMD)'
	'vulkan-nouveau: for Vulkan GPU driver (NVIDIA)'
	'mesa: for Mesa instance'
	'mesa-utils: for OpenGL version (glxinfo)'
)
