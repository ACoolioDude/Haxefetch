# Handle main source directory
-p src

# Find main class that will target
-main Haxefetch

# Optimize flags
-D analyzer-optimize

# Compile to specific binary
-cpp bin/cpp

# Use compiler for compilation
-D HXCPP_M64

# Move compiled binary and rename it to correct name
--cmd command mv bin/cpp/Haxefetch bin/cpp/haxefetch

# Add resources
--resource src/resources/logos/alpine.txt@alpine
--resource src/resources/logos/arch.txt@arch
--resource src/resources/logos/artix.txt@artix
--resource src/resources/logos/bazzite.txt@bazzite
--resource src/resources/logos/cachyos.txt@cachy
--resource src/resources/logos/debian.txt@debian
--resource src/resources/logos/endeavouros.txt@endeavour
--resource src/resources/logos/fedora.txt@fedora
--resource src/resources/logos/gentoo.txt@gentoo
--resource src/resources/logos/manjaro.txt@manjaro
--resource src/resources/logos/mint.txt@mint
--resource src/resources/logos/nixos.txt@nix
--resource src/resources/logos/slackware.txt@slack
--resource src/resources/logos/solus.txt@solus
--resource src/resources/logos/steamos.txt@steam
--resource src/resources/logos/opensuse.txt@suse
--resource src/resources/logos/ubuntu.txt@ubuntu
--resource src/resources/logos/void.txt@void

--resource src/resources/mini_logos/alpine.txt@apline_small
--resource src/resources/mini_logos/arch.txt@arch_small
--resource src/resources/mini_logos/artix.txt@artix_small
--resource src/resources/mini_logos/cachyos.txt@cachy_small
--resource src/resources/mini_logos/debian.txt@debian_small
--resource src/resources/mini_logos/endeavouros.txt@endeavour_small
--resource src/resources/mini_logos/fedora.txt@fedora_small
--resource src/resources/mini_logos/gentoo.txt@gentoo_small
